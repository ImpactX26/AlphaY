# Copy to apps/api/.env
DATABASE_URL=postgres://educaro:educaro@localhost:5433/educaro
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000
STORAGE_DIR=../../storage

# LLM. Groq (free) does the bulk work; OpenAI is the quality tier with a hard spend cap.
# With neither key set, every task falls back to rules and templates so the app still runs.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Hard cap on OpenAI spend across the whole prototype, in USD. Calls stop and fall back to Groq above it.
OPENAI_BUDGET_USD=40
# Which provider the "quality" tier uses: openai | groq
LLM_QUALITY_PROVIDER=openai

# Web search for specialists: duckduckgo (no key) | tavily
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Mail: the team's own mailbox. Gmail: turn on 2-step verification, then create an App Password.
# SMTP sends, IMAP reads replies. Leave SMTP_USER empty to use the local Mailpit catcher instead (UI on :8025).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
MAIL_FROM=
# Safe mode (keep it on): any recipient not in MAIL_ALLOWED is redirected to MAIL_SAFE_REDIRECT,
# with the original recipient shown in the subject. The prototype never mails a real university or employer.
MAIL_SAFE_MODE=true
MAIL_SAFE_REDIRECT=
# Comma-separated addresses or @domains that may receive mail as-is (e.g. teammates' inboxes).
MAIL_ALLOWED=
MAIL_POLL_SECONDS=20
MAILPIT_URL=http://localhost:8025

# Discord (optional)
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
