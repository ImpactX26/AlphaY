# Copy to apps/api/.env. Everything below is optional: with no keys at all the app still runs,
# because every model-backed feature has a rule-based fallback.

DATABASE_URL=postgres://educaro:educaro@localhost:5433/educaro
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
PORT=3000
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000
STORAGE_DIR=../../storage

# ---- LLM ----
# Groq (free) is the "cheap" tier and does the bulk of the work, including Whisper transcription.
# OpenAI is the "quality" tier (supervisor plans, letters) under a hard spend cap.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BUDGET_USD=40
LLM_QUALITY_PROVIDER=openai

# Local Whisper fallback (tools/whisper/.venv), used when Groq has no key or is rate limited.
LOCAL_WHISPER_PYTHON=../../tools/whisper/.venv/Scripts/python.exe
LOCAL_WHISPER_MODEL=base

# ---- web tools ----
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# ---- mail ----
# Leave SMTP_USER/SMTP_PASS empty to use Mailpit only (nothing leaves the machine).
# Fill them with the team Gmail + App Password to really send and to read replies over IMAP.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
MAIL_FROM=Educaro Agent <agent@educaro.local>
MAIL_POLL_SECONDS=30
# Safe mode: a prototype must never mail a real university or employer.
# Third-party recipients are rewritten to MAIL_SAFE_REDIRECT (or the team mailbox).
MAIL_SAFE_MODE=true
MAIL_SAFE_REDIRECT=
MAIL_ALLOWED=
# Every mail is mirrored here, and the staff "Mail tracker" page embeds this UI.
MAILPIT_URL=http://localhost:8025

# ---- Discord (optional) ----
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
