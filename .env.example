# Copy to apps/api/.env. Everything below is optional: with no keys at all the app still runs,
# because every model-backed feature has a rule-based fallback.

DATABASE_URL=postgres://educaro:educaro@localhost:5433/educaro
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
PORT=3000
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000
STORAGE_DIR=../../storage

# ---- LLM ----
# Groq (free) is the "cheap" tier and does the bulk of the work, including Whisper transcription.
# OpenAI is the "quality" tier (supervisor plans, letters) under a hard spend cap.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# `whisper-large-v3` over `-turbo`: 10.3% word error rate against turbo's 12% by Groq's own
# figures, and turbo cuts the decoder from 32 layers to 4 — the part that resolves an unfamiliar
# accent. Both are free; the full model is a little slower and is the right trade here.
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BUDGET_USD=40
LLM_QUALITY_PROVIDER=openai
# Which provider leads every call: openai | groq | auto.
# 'auto' keeps Groq for cheap work and OpenAI for quality; 'openai' puts the paid key in front
# of everything and leaves Groq as the fallback once the budget cap is reached.
LLM_PROVIDER=openai

# Local Whisper fallback (tools/whisper/.venv), used when Groq has no key or is rate limited.
LOCAL_WHISPER_PYTHON=../../tools/whisper/.venv/Scripts/python.exe
# `small.en` over `base`: base is the multilingual model and mangles accented English badly enough
# that the agent reasons over words nobody said. This path only runs with no Groq key, so the extra
# CPU second is the cheaper mistake. `medium.en` is better again if the machine can take it.
LOCAL_WHISPER_MODEL=small.en

# A model on this machine, through Ollama (or anything else speaking the OpenAI API). No quota and
# no bill, so the hundreds of calls that go into testing stop competing with the ones a reviewer
# makes. Slower and smaller than the hosted models, so LOCAL_LLM_FIRST is opt-in.
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_FIRST=0

# ---- web tools ----
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# ---- mail ----
# Leave SMTP_USER/SMTP_PASS empty to use Mailpit only (nothing leaves the machine).
# Fill them with the team Gmail + App Password to really send and to read replies over IMAP.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
MAIL_FROM=Educaro Agent <agent@educaro.local>
MAIL_POLL_SECONDS=30
# Safe mode: a prototype must never mail a real university or employer.
# Third-party recipients are rewritten to MAIL_SAFE_REDIRECT (or the team mailbox).
MAIL_SAFE_MODE=true
MAIL_SAFE_REDIRECT=
# Addresses that may receive real mail. Everything else is redirected to MAIL_SAFE_REDIRECT, with
# the intended recipient kept in the subject and in the mail tracker, so a prototype never mails a
# real admissions office by accident. To send to a genuine address during a demo, put it here:
#   MAIL_ALLOWED=admissions@example-university.de
# A leading @ allowlists a whole domain: MAIL_ALLOWED=@example-university.de
MAIL_ALLOWED=
# Every mail is mirrored here, and the staff "Mail tracker" page embeds this UI.
MAILPIT_URL=http://localhost:8025

# ---- Discord (optional) ----
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# ---- voice (optional) ----
# ElevenLabs reads the mock-interview questions aloud. Without it the browser's own
# speechSynthesis does the job for free, so this is an upgrade and never a requirement.
# Put the real key in apps/api/.env, which is gitignored. Never in this file: it is committed.
ELEVENLABS_API_KEY=
# Rachel, a calm neutral English voice. Any voice id from your ElevenLabs library works.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
